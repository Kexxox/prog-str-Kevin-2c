<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicaexamen.Controllers.AppController">
    <children>
        <Label prefHeight="18.0" prefWidth="375.0" text="Registro De Contactos De Emergencia" />
        <HBox prefHeight="59.0" prefWidth="600.0">
            <children>
                <ComboBox fx:id="cmbParentesco" prefWidth="150.0" promptText="Parentesco" />
            </children>
        </HBox>
        <HBox prefHeight="59.0" prefWidth="238.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onAgregar" prefHeight="26.0" prefWidth="66.0" text="Agregar" />
                <Button mnemonicParsing="false" onAction="#onBuscar" prefHeight="26.0" prefWidth="66.0" text="Buscar" />
                <Button mnemonicParsing="false" onAction="#onActualizar" prefHeight="26.0" prefWidth="76.0" text="Actualizar" />
                <Button mnemonicParsing="false" onAction="#onEliminar" prefHeight="26.0" prefWidth="66.0" text="Eliminar" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" prefHeight="26.0" prefWidth="66.0" text="Limpiar" />
            </children>
        </HBox>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label prefHeight="18.0" prefWidth="44.0" text="Nombre" />
                <Label text="Telefono" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" />
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <ListView fx:id="listView" prefHeight="143.0" prefWidth="600.0" />
        <Label fx:id="lblMsg" />
    </children>
</VBox>
